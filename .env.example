# Copy to .env and fill in real values (.env is gitignored).
# Postgres connection string. The database name is the last path segment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sakuradio?schema=public"

# AI Gateway (Vercel) — AI dream-to-action layer (Phase 2). Server-side only.
AI_GATEWAY_API_KEY=""

# Better Auth — server-side session signing secret (auth layer).
BETTER_AUTH_SECRET=""
