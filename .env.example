# Copy to .env and fill in real values (.env is gitignored).
# Postgres connection string. The database name is the last path segment.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/sakuradio?schema=public"

# AI Gateway (Vercel) — powers /api/capture. Server-side only.
AI_GATEWAY_API_KEY=""
# Optional: override the gateway model id (creator/model). Defaults to Haiku 4.5.
# AI_MODEL="anthropic/claude-haiku-4.5"

# Better Auth — server-side session signing secret.
BETTER_AUTH_SECRET=""
# Public base URL of the deployment (needed for correct auth cookies).
# On Vercel, VERCEL_URL is used automatically; set this to your stable domain.
# BETTER_AUTH_URL="https://your-domain.vercel.app"
# Optional extra trusted web origins (comma-separated).
# BETTER_AUTH_TRUSTED_ORIGINS="https://your-domain.vercel.app"

# Native app only: absolute API base so the app can reach the deployed backend.
# EXPO_PUBLIC_API_URL="https://your-domain.vercel.app"
